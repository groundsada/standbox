[0.044, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.001, "o", "\u001b[1mstandbox\u001b[0m  per-agent client-side permission gates for CLIs\r\n"]
[0.000, "o", "\u001b[2mone generator, any CLI: describe the policy in English, get an enforced gate\u001b[0m\r\n\r\n"]
[2.007, "o", "\r\n\u001b[1m=== kubectl ===\u001b[0m\r\n\u001b[32m$ standbox_generate \"only namespace mfsada, crud on pods and deployments, port-forward allowed, no jobs but cronjobs ok, no secrets\"\u001b[0m\r\n"]
